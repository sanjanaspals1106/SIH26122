# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database (Supabase Postgres, direct connection — M6 sets up the shared project) ---
# Get this from Supabase dashboard > Project Settings > Database > Connection string (URI, service role)
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres

# --- Auth (Supabase Auth) ---
# Only needed once shared/auth.py's real (non-stub) verification is in place.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# M2's temporary local auth stub only — see backend/shared/auth.py.
# Set to true for dev/test mode without Supabase frontend login:
AUTH_DEV_MODE=true

# --- LLM (Groq primary, Gemini fallback — both free tier, both OpenAI-compatible) ---
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile
# To fail over to Gemini instead, without touching code:
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=your-gemini-key-here
#   LLM_MODEL=gemini-2.5-flash

# --- M4's evidence-check config (synthetic demo site) ---
PROJECT_SITE_LAT=0.0
PROJECT_SITE_LON=0.0
PROJECT_SITE_RADIUS_KM=5
