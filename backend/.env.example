# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database (Supabase Postgres, direct connection — M6 sets up the shared project) ---
# Get this from Supabase dashboard > Project Settings > Database > Connection string (URI, service role)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Auth (Supabase Auth) ---
# Only needed once shared/auth.py's real (non-stub) verification is in place.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# M2's temporary local auth stub only — see the warning at the top of
# backend/shared/auth.py. Set to false once M6's real auth.py lands.
AUTH_DEV_MODE=true

# --- LLM (Groq primary, Gemini fallback — both free tier, both OpenAI-compatible) ---
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Project site GPS configuration - owned by M4
PROJECT_SITE_LAT=27.4728
PROJECT_SITE_LON=95.3547
PROJECT_SITE_RADIUS_KM=5.0

