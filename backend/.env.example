# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres

# Supabase Auth
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
# Publishable key (Supabase dashboard: SUPABASE_PUBLISHABLE_KEY or SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=
# Secret key (Supabase dashboard: SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWKS URL for asymmetric JWT verification (ES256)
SUPABASE_JWKS_URL=https://<PROJECT-REF>.supabase.co/auth/v1/.well-known/jwks.json

# LLM configuration - owned by M2
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Optional: Supabase JWT Secret for offline HMAC-SHA256 token verification
# Leave empty when using JWKS verification (do NOT put JWKS URL here).
SUPABASE_JWT_SECRET=
JWT_SECRET=

# Optional: P6 EPPM REST Integration URL.
# Leave empty to disable network write-back.
# For local mock P6, use the mock endpoint when the application is running (e.g. http://localhost:8000/api/v1/mock-p6).
P6_BASE_URL=

# Optional: Demo Supabase Auth user IDs used by canonical seed data.
DEMO_SITE_ENGINEER_USER_ID=
DEMO_SUPERVISOR_USER_ID=
